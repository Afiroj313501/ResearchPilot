DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
